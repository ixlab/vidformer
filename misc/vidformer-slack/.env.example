# Copy to .env and fill in. `.env` is gitignored -- do not commit real tokens.

# Slack app credentials (Socket Mode)
export SLACK_BOT_TOKEN=xoxb-your-bot-token
export SLACK_APP_TOKEN=xapp-your-app-token

# LLM used to generate the vidformer cv2 code
export CEREBRAS_API_KEY=your-cerebras-api-key

# Vidformer server. Defaults to the public guest endpoint.
export VIDFORMER_API_URL=api.vidformer.org
export VIDFORMER_API_KEY=VF_GUEST
