{
    "display_information": {
        "name": "Vidformer"
    },
    "features": {
        "bot_user": {
            "display_name": "Vidformer",
            "always_online": false
        },
        "unfurl_domains": [
            "f.dominik.win",
            "dominik.win",
            "cdn.vidformer.org"
        ]
    },
    "oauth_config": {
        "scopes": {
            "bot": [
                "app_mentions:read",
                "channels:history",
                "chat:write",
                "commands",
                "mpim:history",
                "mpim:read",
                "mpim:write",
                "users:read",
                "links:read",
                "links:write",
                "links.embed:write"
            ]
        }
    },
    "settings": {
        "event_subscriptions": {
            "bot_events": [
                "app_mention",
                "link_shared"
            ]
        },
        "interactivity": {
            "is_enabled": true
        },
        "org_deploy_enabled": false,
        "socket_mode_enabled": true,
        "token_rotation_enabled": false
    }
}